# ==============================================================================
# Dheeksha Insurance — Production Nginx Configuration Template
# ==============================================================================
# This template provides a hardened reverse proxy and static asset server for
# the Dheeksha Insurance web application (React + Vite SPA frontend and
# Node.js/Express 5 API backend).
#
# IMPORTANT:
# - Review and replace all placeholders enclosed in <ANGLE_BRACKETS> before use.
# - Do NOT use this file directly without customization for your server environment.
# - Ensure file permissions and TLS certificates exist before reloading Nginx.
# ==============================================================================

# ------------------------------------------------------------------------------
# Upstream Definition for Express API
# ------------------------------------------------------------------------------
upstream express_backend {
    # Node.js Express server socket or loopback address
    # Default backend port in backend-node/.env is 8000
    server 127.0.0.1:8000 max_fails=3 fail_timeout=10s;
    keepalive 32;
}

# ------------------------------------------------------------------------------
# HTTP Server Block: Redirect all plaintext HTTP to HTTPS
# ------------------------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name <DOMAIN_NAME> www.<DOMAIN_NAME>;

    # ACME Challenge location for Let's Encrypt / Certbot automated renewals
    location ^~ /.well-known/acme-challenge/ {
        root <ACME_WEBROOT_PATH>; # e.g., /var/www/certbot
        default_type "text/plain";
        allow all;
    }

    # Redirect all other HTTP traffic to HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

# ------------------------------------------------------------------------------
# HTTPS Server Block: Hardened Static Assets + API Reverse Proxy
# ------------------------------------------------------------------------------
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name <DOMAIN_NAME> www.<DOMAIN_NAME>;

    # --------------------------------------------------------------------------
    # SSL/TLS Configuration
    # --------------------------------------------------------------------------
    # Replace with valid paths to your certificates (e.g. from Let's Encrypt)
    ssl_certificate <PATH_TO_SSL_CERTIFICATE>;      # e.g., /etc/letsencrypt/live/<DOMAIN_NAME>/fullchain.pem
    ssl_certificate_key <PATH_TO_SSL_CERTIFICATE_KEY>;  # e.g., /etc/letsencrypt/live/<DOMAIN_NAME>/privkey.pem

    # Modern TLS configuration (TLSv1.2 and TLSv1.3 only)
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;

    # SSL session caching and ticket handling
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    # OCSP Stapling (uncomment when valid DNS resolver is available)
    # ssl_stapling on;
    # ssl_stapling_verify on;
    # ssl_trusted_certificate <PATH_TO_CA_CHAIN>;
    # resolver 8.8.8.8 1.1.1.1 valid=300s;
    # resolver_timeout 5s;

    # --------------------------------------------------------------------------
    # Root and Index
    # --------------------------------------------------------------------------
    # Root directory pointing to the built Vite frontend distribution
    root <PATH_TO_FRONTEND_DIST>; # e.g., /var/www/dheeksha-insurance/frontend/dist
    index index.html;

    # Request limits
    client_max_body_size 10M;

    # --------------------------------------------------------------------------
    # Security Headers
    # --------------------------------------------------------------------------
    # Prevent MIME type sniffing
    add_header X-Content-Type-Options "nosniff" always;

    # Prevent clickjacking / framing
    add_header X-Frame-Options "SAMEORIGIN" always;

    # Referrer policy
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Restrict sensitive browser APIs
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;

    # HTTP Strict Transport Security (HSTS)
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Content Security Policy (CSP):
    # - default-src 'self': Restrict fallbacks to same origin.
    # - script-src 'self' 'unsafe-inline': Required for early FOUC theme/language script in index.html.
    #   (Note: For strict nonce/hash CSP, calculate sha256 of inline script in index.html).
    # - style-src 'self' 'unsafe-inline' https://fonts.googleapis.com: Google Fonts stylesheets and Tailwind runtime styles.
    # - font-src 'self' https://fonts.gstatic.com data:: Google Fonts webfonts (Noto Sans Tamil, Poppins).
    # - img-src 'self' data: blob: https://images.unsplash.com: Unsplash vehicle images and SVG icons.
    # - connect-src 'self' <ADDITIONAL_API_ORIGIN_IF_NOT_SAME_ORIGIN>: API requests.
    # - frame-ancestors 'self': Guard against external embedding.
    # - base-uri 'self': Prevent base tag manipulation.
    # - form-action 'self': Prevent form submission hijacking.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://images.unsplash.com; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self';" always;

    # --------------------------------------------------------------------------
    # Gzip Compression
    # --------------------------------------------------------------------------
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types
        application/javascript
        application/json
        application/xml
        application/xml+rss
        image/svg+xml
        text/css
        text/javascript
        text/plain
        text/xml;

    # --------------------------------------------------------------------------
    # Static Assets Caching (Vite Fingerprinted Bundles)
    # --------------------------------------------------------------------------
    # Vite bundles assets in /assets/ with cryptographic hashes (e.g. index-B_9Wq1kK.js).
    # These files are immutable and can be cached aggressively for 1 year.
    location ^~ /assets/ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    # Static root assets (favicon, robots.txt, etc.)
    location ~* \.(?:ico|svg|png|jpg|jpeg|gif|webp|woff|woff2|ttf|eot)$ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
        access_log off;
    }

    # Ensure index.html is revalidated so users receive fresh script references on release
    location = /index.html {
        expires -1;
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0";
    }

    # --------------------------------------------------------------------------
    # API Reverse Proxy (Express Backend)
    # --------------------------------------------------------------------------
    # Forwards /api/ requests to the Node.js Express backend.
    #
    # PROXY TRUST ALIGNMENT:
    # Express in backend-node uses `TRUST_PROXY=1` (or configured value in .env).
    # Nginx must supply the true client IP via `X-Forwarded-For`.
    # When `X-Forwarded-For $remote_addr` is sent, Express rate-limiting and audit
    # logs record the actual client IP instead of 127.0.0.1.
    # --------------------------------------------------------------------------
    location /api/ {
        proxy_pass http://express_backend;
        proxy_http_version 1.1;

        # Connection header handling for HTTP/1.1 keepalive
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Forwarded identity headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;

        # Timeouts
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;

        # Disable buffering for low-latency API interactions
        proxy_buffering off;
    }

    # --------------------------------------------------------------------------
    # React Router SPA Fallback
    # --------------------------------------------------------------------------
    # Any route not matching a physical static file or /api/ is routed to index.html.
    # This allows client-side React Router navigation (e.g. /services, /admin/dashboard)
    # to render properly without returning HTTP 404 on page refresh or direct URL entry.
    # --------------------------------------------------------------------------
    location / {
        try_files $uri $uri/ /index.html;
    }

    # --------------------------------------------------------------------------
    # Deny Hidden Files
    # --------------------------------------------------------------------------
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
}
