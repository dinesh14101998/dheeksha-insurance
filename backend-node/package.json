{
  "name": "dheeksha-insurance-backend-node",
  "version": "1.0.0",
  "private": true,
  "description": "Node.js and Express backend for Dheeksha Insurance",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "db:init": "node src/scripts/initDb.js",
    "test:smtp": "node src/scripts/verifySmtp.js",
    "verify:app": "node src/scripts/verifyApplication.js"
  },
  "keywords": [
    "insurance",
    "express",
    "api"
  ],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.2.1"
  }
}
