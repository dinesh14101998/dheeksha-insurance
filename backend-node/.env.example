# ==============================================================================
# Dheeksha Insurance — Node.js / Express Backend Environment Configuration
# Safe Example Template (Contains NO actual credentials or production secrets)
# ==============================================================================

# Application Environment Mode ('development' | 'production' | 'test')
NODE_ENV="development"

# Server Port
PORT=8000

# MariaDB / MySQL Connection URL (To be configured in Phase 2.2)
DATABASE_URL="mysql://<username>:<password>@localhost:3306/dheeksha_insurance"

# JWT Authentication Secret (Must be cryptographically random and >= 32 characters)
SECRET_KEY="REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Initial Admin Credentials (Seeded on startup in Phase 2.3)
ADMIN_EMAIL="your-admin-email@example.com"
ADMIN_PASSWORD="REPLACE_WITH_A_STRONG_UNIQUE_PASSWORD"

# CORS Configuration (Comma-separated list of allowed frontend origins)
FRONTEND_URL="http://localhost:5173"

# Reverse Proxy Trust Configuration (default: false)
# When deployed behind a single reverse proxy (e.g. Nginx on localhost or in Docker), set TRUST_PROXY=1
# When deployed directly without a reverse proxy, set TRUST_PROXY=false
TRUST_PROXY="false"

# Gmail SMTP Configuration (Configured for notifications to business owner)
# Host: smtp.gmail.com | Port: 587 | Secure: false (uses STARTTLS)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-business-email@gmail.com"
SMTP_PASSWORD="your-16-character-gmail-app-password"
NOTIFICATION_EMAIL="neelkanthbpvi@gmail.com"

# ==============================================================================
# Integration Testing Configuration (Phase 2.9)
# Requires manual pre-provisioning of dheeksha_insurance_test schema
# ==============================================================================
# RUN_DB_INTEGRATION_TESTS="false"
# TEST_DATABASE_URL="mysql://dheeksha_test_user:<test-password>@localhost:3306/dheeksha_insurance_test"


